# LLM Provider: openai | ollama | mlx
SWIFTIE_LLM_PROVIDER=openai

# OpenAI
SWIFTIE_OPENAI_API_KEY=sk-...
SWIFTIE_OPENAI_MODEL=gpt-4-turbo-preview

# Ollama (local LLM)
SWIFTIE_OLLAMA_BASE_URL=http://localhost:11434
SWIFTIE_OLLAMA_MODEL=llama3:8b

# MLX (Apple Silicon)
SWIFTIE_MLX_MODEL=mlx-community/Mistral-7B-Instruct-v0.3-4bit

# Storage
SWIFTIE_CHROMA_PERSIST_DIR=./data/chroma
SWIFTIE_DB_URL=sqlite:///./data/swiftie.db

# Memory
SWIFTIE_CONTEXT_WINDOW=20
SWIFTIE_MEMORY_DECAY_HOURS=168

# Voice
SWIFTIE_WHISPER_MODEL=base.en
SWIFTIE_TTS_MODEL=en_US-lessac-medium

# Privacy: force all-local processing
SWIFTIE_PRIVACY_MODE=false
